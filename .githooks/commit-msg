#!/bin/sh
set -eu

commit_message_file=$1
subject=
IFS= read -r subject < "$commit_message_file" || true

case "$subject" in
  "Merge "*|"Revert \""*)
    exit 0
    ;;
esac

pattern='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-z0-9][a-z0-9._/-]*\))?(!)?: .+'

if printf '%s\n' "$subject" | grep -Eq "$pattern"; then
  exit 0
fi

printf '%s\n' \
  'Commit message must use the Conventional Commit format.' \
  '' \
  '  type(scope)!: description' \
  '' \
  'Allowed types: build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test.' \
  'Example: feat(cli): filter processes by directory' >&2
exit 1
